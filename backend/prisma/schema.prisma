generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("user") // "admin" | "user"
  createdAt    DateTime @default(now())
}

model Furnace {
  id   Int    @id @default(autoincrement())
  no   Int    @unique
  name String

  gasReadings    GasReading[]
  chargeEntries  ChargeEntry[]
  chargeRecords  ChargeRecord[]
  importBatches  ImportBatch[]
}

model GasReading {
  id               Int      @id @default(autoincrement())
  furnaceId        Int
  furnace          Furnace  @relation(fields: [furnaceId], references: [id], onDelete: Cascade)
  ts               DateTime
  temp             Float?
  gas              Float?
  gasCumulative    Float
  power            Float?
  powerCumulative  Float?
  temp2            Float?
  temp3            Float?
  importBatchId    Int?
  importBatch      ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([furnaceId, ts])
  @@index([furnaceId, ts])
}

model ChargeEntry {
  id              Int          @id @default(autoincrement())
  chargeNo        String
  furnaceId       Int
  furnace         Furnace      @relation(fields: [furnaceId], references: [id], onDelete: Cascade)
  gasBefore       Float?
  gasAfter        Float?
  usage           Float?
  workDate        DateTime
  shift           String       // "day" | "night"
  source          String       @default("manual") // "auto" | "manual" | "paste" | "upload"
  chargeRecordId  Int?
  chargeRecord    ChargeRecord? @relation(fields: [chargeRecordId], references: [id], onDelete: SetNull)
  note            String?

  @@index([furnaceId])
  @@index([workDate])
  @@index([furnaceId, workDate])
  @@index([chargeRecordId])
}

model ChargeScan {
  id               Int           @id @default(autoincrement())
  fileUrl          String
  originalFileName String
  uploadedAt       DateTime      @default(now())
  pageCount        Int?
  status           String        @default("uploaded") // "uploaded" | "processed" | "error"

  chargeRecords    ChargeRecord[]

  @@index([uploadedAt])
}

model ChargeRecord {
  id           Int         @id @default(autoincrement())
  chargeScanId Int
  chargeScan   ChargeScan  @relation(fields: [chargeScanId], references: [id], onDelete: Cascade)
  pageIndex    Int
  furnaceId    Int
  furnace      Furnace     @relation(fields: [furnaceId], references: [id], onDelete: Cascade)
  workDate     DateTime
  shift        String       // "day" | "night"
  workEnd      DateTime
  workStart    DateTime?
  material     String?
  weightKg     Float?
  note         String?

  chargeEntries ChargeEntry[]

  @@index([chargeScanId])
  @@index([furnaceId])
  @@index([workDate])
}

model ImportBatch {
  id           Int           @id @default(autoincrement())
  fileName     String
  furnaceId    Int?
  furnace      Furnace?      @relation(fields: [furnaceId], references: [id], onDelete: SetNull)
  periodStart  DateTime?
  periodEnd    DateTime?
  rowCount     Int           @default(0)
  successCount Int           @default(0)
  errorCount   Int           @default(0)
  createdAt    DateTime      @default(now())

  gasReadings  GasReading[]

  @@index([createdAt])
}
