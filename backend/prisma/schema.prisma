generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["taewoong_furnace"]
}

enum UserRole {
  admin
  user

  @@schema("taewoong_furnace")
}

enum Shift {
  day
  night

  @@schema("taewoong_furnace")
}

enum ChargeSource {
  auto
  manual
  paste
  upload

  @@schema("taewoong_furnace")
}

enum ChargeScanStatus {
  uploaded
  processed
  error

  @@schema("taewoong_furnace")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         UserRole @default(user)
  createdAt    DateTime @default(now())

  @@schema("taewoong_furnace")
}

model Furnace {
  id   Int    @id @default(autoincrement())
  no   Int    @unique
  name String

  gasReadings    GasReading[]
  chargeEntries  ChargeEntry[]
  chargeRecords  ChargeRecord[]
  importBatches  ImportBatch[]

  @@schema("taewoong_furnace")
}

model GasReading {
  id               Int      @id @default(autoincrement())
  furnaceId        Int
  furnace          Furnace  @relation(fields: [furnaceId], references: [id], onDelete: Cascade)
  ts               DateTime
  temp             Float?
  gas              Float?
  gasCumulative    Float
  power            Float?
  powerCumulative  Float?
  temp2            Float?
  temp3            Float?
  importBatchId    Int?
  importBatch      ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([furnaceId, ts])
  @@index([furnaceId, ts])
  @@index([importBatchId])
  @@schema("taewoong_furnace")
}

model ChargeEntry {
  id              Int          @id @default(autoincrement())
  chargeNo        String
  furnaceId       Int
  furnace         Furnace      @relation(fields: [furnaceId], references: [id], onDelete: Cascade)
  gasBefore       Float?
  gasAfter        Float?
  usage           Float?
  workDate        DateTime
  shift           Shift
  source          ChargeSource @default(manual)
  chargeRecordId  Int?
  chargeRecord    ChargeRecord? @relation(fields: [chargeRecordId], references: [id], onDelete: SetNull)
  note            String?

  @@index([furnaceId])
  @@index([workDate])
  @@index([shift])
  @@index([furnaceId, workDate])
  @@index([furnaceId, shift])
  @@index([chargeRecordId])
  @@unique([chargeNo])
  @@schema("taewoong_furnace")
}

model ChargeScan {
  id               Int              @id @default(autoincrement())
  fileUrl          String
  originalFileName String
  uploadedAt       DateTime         @default(now())
  pageCount        Int?
  status           ChargeScanStatus @default(uploaded)

  chargeRecords    ChargeRecord[]

  @@index([uploadedAt])
  @@schema("taewoong_furnace")
}

model ChargeRecord {
  id           Int         @id @default(autoincrement())
  chargeScanId Int
  chargeScan   ChargeScan  @relation(fields: [chargeScanId], references: [id], onDelete: Cascade)
  pageIndex    Int
  furnaceId    Int
  furnace      Furnace     @relation(fields: [furnaceId], references: [id], onDelete: Cascade)
  workDate     DateTime
  shift        Shift
  workEnd      DateTime
  workStart    DateTime?
  material     String?
  weightKg     Float?
  note         String?

  chargeEntries ChargeEntry[]

  @@index([chargeScanId])
  @@index([furnaceId])
  @@index([workDate])
  @@index([furnaceId, shift, workEnd])
  @@schema("taewoong_furnace")
}

model ImportBatch {
  id           Int           @id @default(autoincrement())
  fileName     String
  furnaceId    Int?
  furnace      Furnace?      @relation(fields: [furnaceId], references: [id], onDelete: SetNull)
  periodStart  DateTime?
  periodEnd    DateTime?
  rowCount     Int           @default(0)
  successCount Int           @default(0)
  errorCount   Int           @default(0)
  createdAt    DateTime      @default(now())

  gasReadings  GasReading[]

  @@index([createdAt])
  @@schema("taewoong_furnace")
}
