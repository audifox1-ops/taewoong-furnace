generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("user") // "admin" or "user"
  createdAt    DateTime @default(now())
}

model Furnace {
  id   Int    @id @default(autoincrement())
  no   Int    @unique // 1-20, excluding 7
  name String // e.g., "가열19호"

  gasReadings    GasReading[]
  chargeEntries  ChargeEntry[]
  chargeRecords  ChargeRecord[]
  gasUsages      GasUsage[]
}

model GasReading {
  id               Int      @id @default(autoincrement())
  furnaceId        Int
  furnace          Furnace  @relation(fields: [furnaceId], references: [id])
  ts               DateTime // timestamp (minute precision)
  temp             Float?
  gas              Float?
  gasCumulative    Float    // 가스누적지침
  power            Float?
  powerCumulative  Float?
  temp2            Float?
  temp3            Float?
  importBatchId    Int?
  importBatch      ImportBatch? @relation(fields: [importBatchId], references: [id])

  @@index([furnaceId, ts])
}

model ChargeEntry {
  id              Int          @id @default(autoincrement())
  chargeNo        String       // e.g., "260610-006"
  furnaceId       Int
  furnace         Furnace      @relation(fields: [furnaceId], references: [id])
  gasBefore       Float?       // 사용전 가스누적지침
  gasAfter        Float?       // 사용후 가스누적지침
  usage           Float?       // 계산값 (gasAfter - gasBefore)
  workDate        DateTime     // 작업일
  shift           String       // "day" or "night"
  source          String       @default("manual") // "auto", "manual", "paste"
  chargeRecordId  Int?         // 장입도 연결
  chargeRecord    ChargeRecord? @relation(fields: [chargeRecordId], references: [id])
  note            String?

  gasUsage        GasUsage?
}

model ChargeScan {
  id               Int           @id @default(autoincrement())
  fileUrl          String
  originalFileName String
  uploadedAt       DateTime      @default(now())
  pageCount        Int?
  status           String        @default("uploaded") // "uploaded", "processed", "error"

  chargeRecords    ChargeRecord[]
}

model ChargeRecord {
  id           Int         @id @default(autoincrement())
  chargeScanId Int
  chargeScan   ChargeScan  @relation(fields: [chargeScanId], references: [id])
  pageIndex    Int         // page number in PDF
  furnaceId    Int
  furnace      Furnace     @relation(fields: [furnaceId], references: [id])
  workDate     DateTime    // 작업일
  shift        String      // "day" or "night"
  workEnd      DateTime    // 수기 작업 종료 시각
  workStart    DateTime?   // 추정 시작 시각
  material     String?     // 재질/품번
  weightKg     Float?      // 중량
  note         String?

  chargeEntries ChargeEntry[]
}

model GasUsage {
  id           Int         @id @default(autoincrement())
  furnaceId    Int
  furnace      Furnace     @relation(fields: [furnaceId], references: [id])
  workDate     DateTime
  shift        String      // "day" or "night"
  periodStart  DateTime
  periodEnd    DateTime
  cumStart     Float       // 시작 시점 가스누적지침
  cumEnd       Float       // 종료 시점 가스누적지침
  usage        Float       // 사용량
  weightKg     Float?      // 장입 중량
  unitRate     Float?      // 원단위 (usage/weightKg)
  chargeEntryId Int?       @unique // ChargeEntry 연결
  chargeEntry  ChargeEntry? @relation(fields: [chargeEntryId], references: [id])

  @@unique([furnaceId, workDate, shift])
}

model ImportBatch {
  id           Int           @id @default(autoincrement())
  fileName     String
  furnaceId    Int?
  periodStart  DateTime?
  periodEnd    DateTime?
  rowCount     Int           @default(0)
  successCount Int           @default(0)
  errorCount   Int           @default(0)
  createdAt    DateTime      @default(now())

  gasReadings  GasReading[]
}
