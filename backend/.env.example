# Database (Supabase PostgreSQL - Connection Pooling)
DATABASE_URL="postgresql://postgres.jottmgcediaaddxnlvhq:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct Connection (prisma migrate 전용)
DIRECT_URL="postgresql://postgres.jottmgcediaaddxnlvhq:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# JWT (NestJS 자체 인증)
