# =====================================================
# TAEWOONG Furnace Management - 환경 변수 설정
# =====================================================
# 이 파일을 .env로 복사하여 사용하세요.
# 프로덕션 환경에서는 반드시 모든 값을 변경하세요.

# ──────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────
# Supabase PostgreSQL - Connection Pooling
DATABASE_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct Connection (prisma migrate 전용)
DIRECT_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# ──────────────────────────────────────────────────────
# Authentication (JWT)
# ──────────────────────────────────────────────────────
# 프로덕션에서는 반드시 강력한 시크릿 키를 사용하세요
# 생성 방법: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="24h"

# ──────────────────────────────────────────────────────
# Supabase Storage (PDF 파일 저장)
# ──────────────────────────────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="taewoong-furnace"

# ──────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────
PORT="3000"

# ──────────────────────────────────────────────────────
# CORS (여러 도메인은 쉼표로 구분)
# ──────────────────────────────────────────────────────
# 예: "http://localhost:5173,https://taewoong-furnace.vercel.app"
CORS_ORIGINS="http://localhost:5173"

# ──────────────────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────────────────
THROTTLE_SHORT_LIMIT=3
THROTTLE_SHORT_TTL=1000
THROTTLE_MEDIUM_LIMIT=20
THROTTLE_MEDIUM_TTL=10000
THROTTLE_LONG_LIMIT=100
THROTTLE_LONG_TTL=60000

# ──────────────────────────────────────────────────────
# Embedded Postgres (로컬 개발용)
# ──────────────────────────────────────────────────────
# 프로덕션에서는 이 값을 설정하지 마세요
# USE_EMBEDDED_POSTGRES="true"
